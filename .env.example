# ── LLM Provider ────────────────────────────────────────────────────────────
# Choose: ollama | openai | gemini
LLM_PROVIDER=ollama

# Model name — leave blank to use the provider default
#   ollama default  : llama3
#   openai default  : gpt-4o-mini
#   gemini default  : gemini-3.5-flash
LLM_MODEL=llama3

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.4

# Request timeout in seconds
LLM_TIMEOUT=200

# ── Ollama (only needed when LLM_PROVIDER=ollama) ───────────────────────────
OLLAMA_URL=http://localhost:11434

# ── OpenAI (only needed when LLM_PROVIDER=openai) ───────────────────────────
OPENAI_API_KEY=sk-...

# Optional: point to any OpenAI-compatible API (e.g. Azure, Groq, Together AI)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Gemini (only needed when LLM_PROVIDER=gemini) ───────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...
